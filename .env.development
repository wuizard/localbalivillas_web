NEXT_PUBLIC_API_BASE_URL=https://lbv-staging-api.wuebuild.com/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GET /reviews/:id returns [] for every property. Fills the wall with the clearly fenced
# demo copy in src/features/review/api/placeholder-reviews.ts, and the demo card ratings in
# src/features/property/api/queries.ts. Never set on the public site.
DEMO_CONTENT=1

# POST /booking/submit is off unless NEXT_PUBLIC_BOOKING_LIVE=1. Development points at the
# staging API above, so the funnel can be exercised without creating a real reservation —
# but the flag stays unset here anyway. What makes a booking real is the API this is aimed
# at, not the flag, and an override that redirected this file at production would otherwise
# arm the funnel silently. Set it only on an environment where you have checked both.
